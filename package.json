{
  "name": "gunk-funk",
  "version": "0.1.0",
  "private": true,
  "description": "GUNK FUNK — a retro 16-bit chaos platformer for the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/combat.mjs && node tests/e2e/enemies.mjs",
    "art:export": "vite-node tools/export-art.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-node": "6.0.0",
    "vitest": "5.1.0"
  }
}
